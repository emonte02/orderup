     info = g_hash_table_lookup(tcg_ctx->helper_table, (gpointer)func);
     flags = info->flags;
@@ -1500,6 +1501,7 @@
             TCGv_i64 ext_temp = tcg_temp_new_i64(tcg_ctx);
