+#ifdef OU_MAPPING_CACHE
+/* Public memory APIs already bypass guest permissions/hooks. Only enabled,
+ * ordinary root RAM with no overlays can use the direct read. Keep original
+ * paths for MMIO, range crossings, subpages and snapshot/CoW state. */
+static MemoryRegion *ou_api_ram_region(uc_engine *uc, uint64_t address,
+                                       uint64_t size)
+{
+    if (!size || uc->snapshot_level) return NULL;
+    MemoryRegion *mr = uc->memory_mapping(uc, address);
+    if (mr && mr->enabled && mr->ram && mr->ram_block && mr->ram_block->host &&
+        !mr->subpage && !mr->is_iommu && mr->container == uc->system_memory &&
+        QTAILQ_EMPTY(&mr->subregions) && address >= mr->addr &&
+        address < mr->end && size <= mr->end-address &&
+        mr->end-mr->addr <= mr->ram_block->used_length)
+        return mr;
+    return NULL;
+}
+#endif
