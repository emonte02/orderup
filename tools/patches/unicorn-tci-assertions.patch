+#if defined(CONFIG_DEBUG_TCG) || defined(OU_TCI_ASSERTIONS)
 # define tci_assert(cond) assert(cond)
 #else
 # define tci_assert(cond) ((void)0)
@@ -495,7 +495,7 @@
 
     for (;;) {
         TCGOpcode opc = tb_ptr[0];
